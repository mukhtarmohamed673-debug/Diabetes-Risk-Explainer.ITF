{
  "name": "Python 3",
  // Python 3.9 matches the version the pinned requirements were tested on.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.9-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app/app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt",
  "postAttachCommand": {
    "server": "streamlit run app/app.py"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
